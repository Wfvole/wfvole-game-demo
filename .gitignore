Library/
Temp/
obj/
Logs/
UserSettings/
MemoryCaptures/
Recordings/

# ========== 构建产物 ==========
# 自定义构建输出目录（你的 WebGL 构建在这里）
output/
Build/
Builds/
BurstAotOutput_*/
DLLs/
*.apk
*.aab
*.unitypackage

# ========== 编译生成文件（Unity 自动生成，无需提交） ==========
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ========== IDE / 工具 ==========
.vscode/
.vs/
.idea/
*.swp
.DS_Store
Thumbs.db

# ========== 日志 ==========
*.log
compact_log.txt

